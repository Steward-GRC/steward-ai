# Local development settings. Copy to .env (git-ignored); `task run` loads it.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Required: Postgres with pgvector, RabbitMQ, Valkey, and the 32-byte
# settings key (base64) that seals the provider credential. Generate a key
# with: openssl rand -base64 32
DATABASE_DSN=postgres://ai:ai@localhost:5432/ai?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_ADDR=localhost:6379
AI_SETTINGS_KEY=

# Ports: gRPC, and HTTP for /livez and /readyz.
GRPC_PORT=9094
PROBE_PORT=8084

# Embeddings: the built-in TEI server (Dockerfile.embeddings), or stub for a
# run with no embeddings server at all.
AI_EMBED_PROVIDER=tei
EMBED_ENDPOINT=http://localhost:8085/embed

# Answer with a labelled stand-in instead of a provider. The module still
# starts off: accept the data notice and turn it on through the API.
AI_GENERATION_STUB=true

# Where PolicyAIJob resources go (a local cluster with the CRD applied).
AI_JOB_NAMESPACE=steward

# Service-to-service authentication. The gateway sends a projected
# service-account token with audience steward; ai verifies it against the
# cluster's JWKS and its per-method allow-list. Local runs without a cluster
# switch it off; never in a cluster.
WORKLOAD_AUTH=disabled
# WORKLOAD_OIDC_ISSUER=https://kubernetes.default.svc
# WORKLOAD_OIDC_JWKS_URL=
# WORKLOAD_OIDC_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# WORKLOAD_OIDC_BEARER_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# WORKLOAD_AUDIENCE=steward
# WORKLOAD_ALLOWED_SERVICEACCOUNTS=steward/steward-gateway

# The operator: no leader election outside a cluster.
ENABLE_LEADER_ELECTION=false
METRICS_PORT=9095
