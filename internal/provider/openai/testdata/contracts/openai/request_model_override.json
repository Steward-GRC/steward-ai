{
  "description": "The request's model overrides the configured one.",
  "reference": "https://platform.openai.com/docs/api-reference/chat/create",
  "call": {
    "settings": {
      "kind": "openai",
      "model": "gpt-4.1",
      "credential": "test-key-1"
