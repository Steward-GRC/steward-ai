          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "Access logs are kept for 90 days.",
                "refusal": null
              },
              "logprobs": null,
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 33,
            "completion_tokens": 9,
            "total_tokens": 42,
            "prompt_tokens_details": {
              "cached_tokens": 0
            },
            "completion_tokens_details": {
