{
  "description": "A refused API key.",
  "reference": "https://docs.anthropic.com/en/api/errors",
  "call": {
    "settings": {
      "credential": "test-key-1",
      "model": "claude-sonnet-4-6"
    },
    "system": "You answer questions about the organisation's policies.",
    "messages": [
      {
        "role": "user",
        "content": "How long are access logs kept?"
      }
    ]
  },
  "exchanges": [
    {
      "request": {
