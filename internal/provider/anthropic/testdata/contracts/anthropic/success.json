{
  "description": "A streamed completion with the system block cached; input tokens count the cache read and cache write.",
  "reference": "https://docs.anthropic.com/en/docs/build-with-claude/streaming",
  "call": {
    "settings": {
      "credential": "test-key-1",
      "model": "claude-sonnet-4-6"
    },
    "system": "You answer questions about the organisation's policies.",
    "messages": [
      {
        "role": "user",
        "content": "How long are access logs kept?"
      }
    ]
  },
  "exchanges": [
